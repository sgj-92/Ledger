{
	"appId": "luxe.sgj.ledger",
	"appName": "Ledger",
	"webDir": "www",
	"backgroundColor": "#0e0b08",
	"server": {
		"url": "https://ledger.sgj.luxe/",
		"errorPath": "offline.html",
		"allowNavigation": [
			"ledger-6aec3.firebaseapp.com"
		],
		"cleartext": false
	},
	"ios": {
		"contentInset": "never"
	},
	"plugins": {
		"SystemBars": {
			"insetsHandling": "css",
			"initialViewportFitValueHint": "cover",
			"style": "DARK"
		},
		"SplashScreen": {
			"launchShowDuration": 700,
			"launchAutoHide": true,
			"launchFadeOutDuration": 200,
			"backgroundColor": "#0e0b08",
			"showSpinner": false
		},
		"Keyboard": {
			"resize": "native"
		}
	},
	"packageClassList": [
		"AppPlugin",
		"KeyboardPlugin",
		"SplashScreenPlugin"
	]
}
