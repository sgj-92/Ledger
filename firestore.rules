rules_version = '2';

// Ledger — Firestore security rules.
//
// The identity boundary is Firebase Authentication. Who may do what is data, not code:
// a profile at ledger_users/{uid} carries a role, "owner" or "partner". Profiles are
// created in the Firebase Console (or with the Admin SDK) — no client can write one, so
// no one can grant themselves a role by signing up.
//
// Ledger is a single-owner app: every existing ledger_* collection is the owner's
// private data and is readable and writable only by an authenticated user whose
// profile role is "owner". A partner gets nothing from these collections, ever.
// Partner access is only through separate, explicitly shared
// collections (see "Shared namespace" below) — never a filtered view of private ones.
//
// Anything not matched here is denied.
//
// Deploy: firebase deploy --only firestore:rules   (see docs/SECURITY.md first —
// the owner profile must exist before these rules go live).

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }
    function profilePath() {
      return /databases/$(database)/documents/ledger_users/$(request.auth.uid);
    }
    function hasRole(role) {
      return signedIn() && exists(profilePath()) && get(profilePath()).data.role == role;
    }
    function isOwner() {
      return hasRole('owner');
    }

    // ---- Identity ----
    // A signed-in user may read their own profile (so the app can learn its role);
    // the owner may read all of them. Roles are granted outside the client only.
    match /ledger_users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isOwner());
      allow write: if false;
    }

    // ---- Private Ledger data: owner only ----
    match /ledger_commitments/{docId=**}        { allow read, write: if isOwner(); }
    match /ledger_plans/{docId=**}              { allow read, write: if isOwner(); }
    match /ledger_sessions/{docId=**}           { allow read, write: if isOwner(); }   // training, weight, steps, nutrition, photos, symptoms
    match /ledger_day_status/{docId=**}         { allow read, write: if isOwner(); }
    match /ledger_priorities/{docId=**}         { allow read, write: if isOwner(); }
    match /ledger_focus/{docId=**}              { allow read, write: if isOwner(); }
    match /ledger_meals/{docId=**}              { allow read, write: if isOwner(); }
    match /ledger_matters/{docId=**}            { allow read, write: if isOwner(); }
    match /ledger_conversations/{docId=**}      { allow read, write: if isOwner(); }
    match /ledger_challenges/{docId=**}         { allow read, write: if isOwner(); }
    // Reset Sprints: temporary clearing sessions. Never shared, never projected.
    match /ledger_sprints/{docId=**}            { allow read, write: if isOwner(); }
    // Life Context: circumstances that affected a day or a stretch of days. Private like
    // the rest of the Owner's record — never projected, never a partner's.
    match /ledger_life_context/{docId=**}       { allow read, write: if isOwner(); }
    // Ask Claude (docs/CLAUDE_ASSISTANT.md): a proposal is written by the server (Admin SDK)
    // and never by a client. The owner reads his own and records what he did with it —
    // applied (all or part), cancelled or undone — and nothing else about it changes.
    // The conversation (ledger_assistant_threads) and the daily count
    // (ledger_assistant_usage) are server-only: unlisted, so no client reaches them.
    match /ledger_assistant_proposals/{proposalId} {
      allow read: if isOwner() && resource.data.ownerUid == request.auth.uid;
      allow update: if isOwner() && resource.data.ownerUid == request.auth.uid
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['status', 'applied', 'appliedAt', 'undoneAt', 'updatedAt'])
                    && request.resource.data.status in ['applied', 'partial', 'cancelled', 'undone'];
      allow create, delete: if false;
    }
    // An Action's Updates: what happened with it, in the owner's words, and quiet facts
    // (state changed, moved, done, reopened). Owner-private like the Action itself — never
    // projected, never a partner request's Updates. Each entry names its owner and author
    // (the signed-in owner), an Action that exists, a known type, and the server's time.
    // Entries are not edited; the owner may remove them.
    match /ledger_action_updates/{updateId} {
      allow read, delete: if isOwner() && resource.data.ownerUid == request.auth.uid;
      allow create: if isOwner()
                    && request.resource.data.keys().hasOnly(['actionId', 'ownerUid', 'type', 'actorUid', 'actorRole', 'text', 'createdAt', 'metadata'])
                    && request.resource.data.ownerUid == request.auth.uid
                    && request.resource.data.actorUid == request.auth.uid
                    && request.resource.data.actionId is string
                    && exists(/databases/$(database)/documents/ledger_commitments/$(request.resource.data.actionId))
                    && request.resource.data.type in ['comment', 'status', 'moved', 'completed']
                    && request.resource.data.actorRole in ['owner', 'system']
                    && (request.resource.data.type != 'comment'
                        || (request.resource.data.actorRole == 'owner' && request.resource.data.text is string && request.resource.data.text.size() > 0))
                    && (request.resource.data.get('text', null) == null
                        || (request.resource.data.text is string && request.resource.data.text.size() <= 500))
                    && request.resource.data.createdAt == request.time
                    && (!('metadata' in request.resource.data) || request.resource.data.metadata is map);
      allow update: if false;
    }

    // ledger_meta holds the owner's preferences and small state documents. One of them,
    // currentFocus, is also an event source: the push sender reads its ownerUid as the
    // recipient, so it must name the owner who wrote it — never anyone else.
    function focusShape(d) {
      return d.keys().hasOnly(['ownerUid', 'type', 'sourceId', 'childId', 'title', 'date', 'setAt',
                               'updatedAt', 'clearedAt', 'sourceDeviceId', 'status', 'timerMin', 'endsAt'])
          && d.ownerUid == request.auth.uid
          && d.status in ['active', 'cleared']
          // an optional timer (2026-10-28): its length in minutes and when it ends
          && (d.get('timerMin', null) == null || (d.timerMin is int && d.timerMin > 0 && d.timerMin <= 600))
          && (d.get('endsAt', null) == null || (d.endsAt is string && d.endsAt.size() <= 40))
          && (d.status == 'cleared'
              || (d.type in ['action', 'sprint_item', 'training']
                  && d.sourceId is string && d.sourceId.size() > 0 && d.sourceId.size() <= 100
                  && d.title is string && d.title.size() <= 300
                  && d.setAt is string));
    }
    // (no subcollections; a {docId=**} wildcard here would let currentFocus skip its shape)
    match /ledger_meta/{docId} {
      allow read: if isOwner();
      allow create, update: if isOwner() && (docId != 'currentFocus' || focusShape(request.resource.data));
      allow delete: if isOwner();
    }

    // ---- Web Push ----
    // A device subscription belongs to the signed-in user who registered it — owner or
    // partner alike — never to "the owner". Each user sees, changes and removes only their
    // own devices; nobody, the owner included, can read another user's. The id starts with
    // the user's uid, so two people on one browser never share a record. Delivery is the
    // Cloud Function's (Admin SDK, not subject to these rules), which finds a user's
    // devices server-side.
    function hasLedgerRole() {
      return isOwner() || hasRole('partner') || hasRole('household');
    }
    function ownId(id) {
      return id.size() > request.auth.uid.size() + 1
          && id[0:request.auth.uid.size() + 1] == request.auth.uid + '_';
    }
    function subShape(d) {
      return d.keys().hasOnly(['userUid', 'endpoint', 'keys', 'deviceId', 'deviceLabel', 'platform',
                               'vapidPublicKey', 'createdAt', 'updatedAt', 'lastSeenAt',
                               'lastSentAt', 'lastError', 'lastErrorAt'])
          && d.userUid == request.auth.uid
          && d.endpoint is string && d.endpoint.size() <= 2048 && d.endpoint.matches('https://.+')
          && d['keys'] is map && d['keys'].p256dh is string && d['keys'].auth is string
          && d.deviceId is string && d.deviceId.size() <= 64
          && (!('deviceLabel' in d) || (d.deviceLabel is string && d.deviceLabel.size() <= 80));
    }
    // The iOS and Android apps: a device's Firebase Cloud Messaging token instead of a Web
    // Push endpoint (docs/NATIVE_MIGRATION.md §5). Additive: the same owner-only rules.
    function fcmShape(d) {
      return d.keys().hasOnly(['userUid', 'transport', 'fcmToken', 'deviceId', 'deviceLabel', 'platform', 'appVersion',
                               'createdAt', 'updatedAt', 'lastSeenAt', 'lastSentAt', 'lastError', 'lastErrorAt'])
          && d.userUid == request.auth.uid
          && d.transport == 'fcm'
          && d.fcmToken is string && d.fcmToken.size() > 0 && d.fcmToken.size() <= 4096
          && d.deviceId is string && d.deviceId.size() <= 64
          && d.platform in ['ios', 'android']
          && (!('deviceLabel' in d) || (d.deviceLabel is string && d.deviceLabel.size() <= 80))
          && (!('appVersion' in d) || (d.appVersion is string && d.appVersion.size() <= 40));
    }
    match /ledger_push_subscriptions/{subId} {
      allow read: if signedIn() && resource.data.userUid == request.auth.uid;
      allow create: if hasLedgerRole() && ownId(subId) && (subShape(request.resource.data) || fcmShape(request.resource.data));
      allow update: if hasLedgerRole() && ownId(subId)
                    && resource.data.userUid == request.auth.uid
                    && (subShape(request.resource.data) || fcmShape(request.resource.data));
      // a device's own record; or, for the owner, the device's record from before
      // subscriptions had a user (found by the id this device's endpoint gave it)
      allow delete: if signedIn()
                    && (resource.data.get('userUid', null) == request.auth.uid
                        || (isOwner() && resource.data.get('userUid', null) == null));
    }
    // Each user's notification choices: theirs alone. The sender reads them server-side.
    match /ledger_notification_prefs/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create, update: if hasLedgerRole() && request.auth.uid == uid
                    && request.resource.data.keys().hasOnly(['currentFocus', 'partner', 'homeOversight', 'updatedAt'])
                    && request.resource.data.get('currentFocus', true) is bool
                    && request.resource.data.get('partner', true) is bool
                    && request.resource.data.get('homeOversight', false) is bool;
      allow delete: if signedIn() && request.auth.uid == uid;
    }
    // Public configuration for the app: the VAPID *public* key. Set in the Console or by
    // the Admin SDK; no client writes it.
    match /ledger_config/{docId} {
      allow read: if hasLedgerRole();
      allow write: if false;
    }
    // Pin now: the owner asks for a push to their own devices. The pin names its owner;
    // only the sender updates it.
    match /ledger_pins/{pinId} {
      allow read, delete: if isOwner();
      allow create: if isOwner()
                    && request.resource.data.ownerUid == request.auth.uid
                    && request.resource.data.text is string
                    && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 500;
      allow update: if false;
    }
    // The sender's own log and de-duplication marks. Server only.
    match /ledger_push_events/{eventId} {
      allow read, write: if false;
    }

    // ---- Home: Shaun, Abi and the people who help at home ----
    // A separate shared namespace. Nothing here reads or reaches a private Ledger
    // collection, and no private collection is opened to anyone by being at Home.
    //
    //   ledger_homes/{homeId}            the Home itself. homeId is the owner's uid.
    //   ledger_home_members/{uid}        one per person: homeId, role (admin | member),
    //                                    status (active | removed). Only the Home's owner
    //                                    writes these; removing someone is a state, so
    //                                    access ends at once and their history stays.
    //   ledger_home_requests/{id}        one shared record per request: requester,
    //                                    assignee and creator are separate, immutable
    //                                    facts (the assignee changes only by reassigning).
    //   .../{id}/updates/{updateId}      its append-only history.
    //
    // Who reads a request: active members of its Home who are admins, or are among its
    // participants (requester, creator and everyone it has been assigned to), or any
    // member when it is shared with the whole Home (visibility 'home').
    function homePath(id) {
      return /databases/$(database)/documents/ledger_homes/$(id);
    }
    function memberPath(uid) {
      return /databases/$(database)/documents/ledger_home_members/$(uid);
    }
    function me() {
      return get(memberPath(request.auth.uid)).data;
    }
    function hasAppRole() {
      return isOwner() || hasRole('partner') || hasRole('household');
    }
    function inHome(homeId) {
      return signedIn() && hasAppRole() && exists(memberPath(request.auth.uid))
          && me().homeId == homeId && me().status == 'active';
    }
    function homeAdmin(homeId) {
      return inHome(homeId) && me().role == 'admin';
    }
    function activeIn(uid, homeId) {
      return uid is string && exists(memberPath(uid))
          && get(memberPath(uid)).data.homeId == homeId && get(memberPath(uid)).data.status == 'active';
    }
    function homeOwner(homeId) {
      return isOwner() && homeId == request.auth.uid && exists(homePath(homeId))
          && get(homePath(homeId)).data.ownerUid == request.auth.uid;
    }
    function canSee(r) {
      return inHome(r.homeId)
          && (me().role == 'admin' || request.auth.uid in r.participants || r.get('visibility', 'private') == 'home');
    }

    match /ledger_homes/{homeId} {
      allow read: if (isOwner() && homeId == request.auth.uid) || inHome(homeId);
      allow create: if isOwner() && homeId == request.auth.uid
                    && request.resource.data.keys().hasOnly(['name', 'ownerUid', 'createdAt', 'updatedAt'])
                    && request.resource.data.ownerUid == request.auth.uid
                    && request.resource.data.name is string && request.resource.data.name.size() <= 40;
      allow update: if homeOwner(homeId)
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'updatedAt'])
                    && request.resource.data.name is string && request.resource.data.name.size() <= 40;
      allow delete: if false;
    }

    // Members: the owner adds and removes them (an account must already hold an app role,
    // granted outside the client). Admins are owner or partner accounts; a household
    // account is always a member. The owner's own record is an active admin, always.
    function memberShape(uid, d) {
      return d.keys().hasOnly(['homeId', 'role', 'status', 'displayName', 'label', 'addedByUid', 'addedAt',
                               'removedByUid', 'removedAt', 'updatedAt'])
          && d.role in ['admin', 'member'] && d.status in ['active', 'removed']
          && d.displayName is string && d.displayName.size() > 0 && d.displayName.size() <= 40
          && (!('label' in d) || d.label == null || (d.label is string && d.label.size() <= 40))
          && exists(/databases/$(database)/documents/ledger_users/$(uid))
          && get(/databases/$(database)/documents/ledger_users/$(uid)).data.role in ['owner', 'partner', 'household']
          && (d.role == 'member' || get(/databases/$(database)/documents/ledger_users/$(uid)).data.role in ['owner', 'partner'])
          && (uid != request.auth.uid || (d.role == 'admin' && d.status == 'active'))
          && (uid == request.auth.uid || get(/databases/$(database)/documents/ledger_users/$(uid)).data.role != 'owner');
    }
    match /ledger_home_members/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || inHome(resource.data.homeId));
      allow create: if homeOwner(request.resource.data.homeId) && memberShape(uid, request.resource.data)
                    && request.resource.data.addedByUid == request.auth.uid;
      allow update: if homeOwner(resource.data.homeId)
                    && request.resource.data.homeId == resource.data.homeId
                    && memberShape(uid, request.resource.data);
      allow delete: if false;
    }

    // "Why it matters": optional, the asker's reason, shown to the person asked
    function homeWhy(d) {
      return d.get('why', null) == null || (d.why is string && d.why.size() <= 300);
    }
    function homeText(d) {
      return d.text is string && d.text.size() > 0 && d.text.size() <= 280
          && (!('note' in d) || d.note == null || (d.note is string && d.note.size() <= 500))
          && homeWhy(d)
          && d.requestedTiming in ['today', 'week', 'date', 'none', 'later']
          && (!('requestedDate' in d) || d.requestedDate == null || d.requestedDate is string);
    }
    // the request's summary of its latest entry, and read marks: each person signs only as
    // themselves and moves only their own read mark
    function homeSummary(o, n) {
      return (n.get('latestUpdateByUid', null) == o.get('latestUpdateByUid', null) || n.latestUpdateByUid == request.auth.uid)
          && (n.get('latestCommentByUid', null) == o.get('latestCommentByUid', null) || n.latestCommentByUid == request.auth.uid)
          && (n.get('latestCommentText', null) == null || (n.latestCommentText is string && n.latestCommentText.size() <= 500))
          && (n.get('readAt', {}).diff(o.get('readAt', {})).affectedKeys().size() == 0
              || n.get('readAt', {}).diff(o.get('readAt', {})).affectedKeys().hasOnly([request.auth.uid]));
    }
    function summaryKeys() {
      return ['latestUpdateAt', 'latestUpdateByUid', 'latestUpdateType', 'latestCommentAt', 'latestCommentByUid',
              'latestCommentText', 'readAt', 'updatedAt'];
    }
    // A request's changes, each kind with who may make it. `keys` (the fields this write
    // changes) is worked out once and passed in: computed in every branch, the rule ran past
    // Firestore's limit of 1,000 expressions and refused writes it should allow.
    function homeReqUpdate(o, n, keys) {
      return (
          // an admin ticks off someone else's request (2026-10-28), or reopens it; never one on
          // someone's day as a private Action, so the Action and the request never disagree.
          // First, cheapest check first: Firestore stops at 1,000 expressions per rule.
          (keys.hasOnly(['status'].concat(summaryKeys()))
              && o.get('linkedActionId', null) == null
              && request.auth.uid != o.get('assigneeUid', null)
              && ((o.status in ['requested', 'planned', 'in_progress', 'cant_do'] && n.status == 'done')
                  || (o.status == 'done' && n.status == 'requested'))
              && homeAdmin(o.homeId)
              && homeSummary(o, n))
          ||
          // an admin corrects any open request: wording, why, note and when (a typo, a
          // date, or no date). The history records it. First: placed after the other
          // branches it ran past the 1,000-expression limit; here it ends at its first
          // check for any other write.
          (keys.hasOnly(['text', 'note', 'why', 'requestedTiming', 'requestedDate'].concat(summaryKeys()))
              && o.status in ['requested', 'planned', 'in_progress', 'cant_do']
              && homeAdmin(o.homeId)
              && homeText(n)
              && homeSummary(o, n))
          ||
          // the person who asked (or wrote it): wording and timing, while it waits
          ((request.auth.uid == o.requesterUid || request.auth.uid == o.createdByUid)
           && o.status == 'requested'
           && keys.hasOnly(['text', 'note', 'why', 'requestedTiming', 'requestedDate'].concat(summaryKeys()))
           && homeText(n)
           && homeSummary(o, n))
          // …or withdraw it, while it waits
          || ((request.auth.uid == o.requesterUid || request.auth.uid == o.createdByUid)
              && o.status == 'requested' && n.status == 'withdrawn'
              && keys.hasOnly(['status'].concat(summaryKeys()))
              && homeSummary(o, n))
          // the assignee: where it stands. Only the owner links a private Action,
          // and only its id ever lands here.
          || (request.auth.uid == o.assigneeUid
              && o.status in ['requested', 'planned', 'in_progress', 'done', 'cant_do', 'missed']
              && n.status in ['requested', 'planned', 'in_progress', 'done', 'cant_do']
              && keys.hasOnly(['status', 'plannedDate', 'linkedActionId',
                   'linkedByUid', 'processedAt', 'cantDoReason'].concat(summaryKeys()))
              && (n.get('linkedActionId', null) == o.get('linkedActionId', null)
                  || n.get('linkedActionId', null) == null
                  || (isOwner() && n.linkedActionId is string && n.linkedByUid == request.auth.uid))
              && (n.get('cantDoReason', null) == null
                  || (n.cantDoReason is string && n.cantDoReason.size() <= 200))
              && homeSummary(o, n))
          // passing it on: the assignee, or an admin, to another active member. The
          // new assignee joins its participants; nobody leaves them.
          || ((request.auth.uid == o.assigneeUid || homeAdmin(o.homeId))
              && o.status in ['requested', 'planned', 'in_progress', 'cant_do']
              && keys.hasOnly(['assigneeUid', 'participants', 'status',
                   'plannedDate', 'linkedActionId', 'linkedByUid', 'cantDoReason', 'processedAt'].concat(summaryKeys()))
              && n.assigneeUid != o.assigneeUid
              // back to whoever asked only when they take it on themselves
              && (n.assigneeUid != o.requesterUid || n.assigneeUid == request.auth.uid)
              && activeIn(n.assigneeUid, o.homeId)
              && n.participants.hasAll(o.participants)
              && n.participants.hasOnly(o.participants.concat([n.assigneeUid]))
              && n.status == 'requested'
              && n.get('plannedDate', null) == null
              && n.get('linkedActionId', null) == null
              && homeSummary(o, n))
          // "I'll do it": anyone at Home takes an unclaimed recurring one, as themselves
          || (o.get('recurringId', null) != null && o.get('assigneeUid', null) == null
              && o.status == 'requested'
              && keys.hasOnly(['assigneeUid', 'participants'].concat(summaryKeys()))
              && n.assigneeUid == request.auth.uid
              && n.participants.hasAll(o.participants)
              && n.participants.hasOnly(o.participants.concat([request.auth.uid]))
              && homeSummary(o, n))
          // who can see it: its creator or an admin
          || ((request.auth.uid == o.createdByUid || homeAdmin(o.homeId))
              && keys.hasOnly(['visibility'].concat(summaryKeys()))
              && n.visibility in ['private', 'home']
              && homeSummary(o, n))
          // the people a checklist belongs to may give a request one
          || (listEditor(o)
              && keys.hasOnly(['hasChecklist', 'updatedAt'])
              && n.hasChecklist == true)
          // anyone who can see it: an update's summary, and their own read mark
          || (keys.hasOnly(summaryKeys())
              && homeSummary(o, n))
          // deleting (soft), by whoever asked or wrote it: frozen from then on
          || ((request.auth.uid == o.requesterUid || request.auth.uid == o.createdByUid)
              && keys.hasOnly(['deletedAt', 'deletedByUid', 'updatedAt'])
              && n.deletedAt is string
              && n.deletedByUid == request.auth.uid)
          // an admin files a request under an ongoing task (once; it stays there),
          // leaving it without a date of its own: its steps carry the dates
          || (o.get('ongoingId', null) == null
              && n.get('ongoingId', null) != null
              && keys.hasOnly(['ongoingId', 'requestedTiming', 'requestedDate', 'updatedAt'])
              && n.get('requestedTiming', 'none') in ['none', 'later', 'today', 'week', 'date']
              && o.get('recurringId', null) == null
              && homeAdmin(o.homeId)
              && ongoingOpenAfter(n.ongoingId, o.homeId))
      );
    }
    match /ledger_home_requests/{rid} {
      allow read: if canSee(resource.data);
      // anyone at Home asks for themselves; an admin may also ask on someone's behalf.
      // Anyone may also add a task for themselves: their own idea (requester = assignee =
      // them), or something another member asked of them in person (requester = that
      // member). The creator is always the signed-in user, so it always shows who wrote it;
      // requester and assignee are active members.
      allow create: if rid.matches('^[A-Za-z0-9]{1,40}$')
                    && inHome(request.resource.data.homeId)
                    && request.resource.data.keys().hasOnly(['homeId', 'text', 'note', 'why', 'requestedTiming', 'requestedDate',
                         'requesterUid', 'assigneeUid', 'createdByUid', 'participants', 'visibility', 'status',
                         'plannedDate', 'linkedActionId', 'createdAt', 'updatedAt', 'latestUpdateAt', 'latestUpdateByUid',
                         'latestUpdateType', 'readAt', 'hasChecklist', 'ongoingId'])
                    && request.resource.data.get('hasChecklist', true) == true
                    && (request.resource.data.get('ongoingId', null) == null
                        || (homeAdmin(request.resource.data.homeId) && ongoingOpenAfter(request.resource.data.ongoingId, request.resource.data.homeId)))
                    && request.resource.data.createdByUid == request.auth.uid
                    && (request.resource.data.requesterUid != request.resource.data.assigneeUid
                        || request.resource.data.assigneeUid == request.auth.uid)
                    && activeIn(request.resource.data.requesterUid, request.resource.data.homeId)
                    && activeIn(request.resource.data.assigneeUid, request.resource.data.homeId)
                    && (request.resource.data.requesterUid == request.auth.uid || me().role == 'admin'
                        || request.resource.data.assigneeUid == request.auth.uid)
                    && request.resource.data.participants.hasAll([request.resource.data.requesterUid, request.resource.data.assigneeUid, request.auth.uid])
                    && request.resource.data.participants.hasOnly([request.resource.data.requesterUid, request.resource.data.assigneeUid, request.auth.uid])
                    && request.resource.data.visibility in ['private', 'home']
                    && request.resource.data.status == 'requested'
                    && request.resource.data.get('plannedDate', null) == null
                    && request.resource.data.get('linkedActionId', null) == null
                    && request.resource.data.get('latestUpdateByUid', request.auth.uid) == request.auth.uid
                    && request.resource.data.get('readAt', {}).keys().hasOnly([request.auth.uid])
                    && homeText(request.resource.data);
      allow update: if notDeleted(resource.data) && canSee(resource.data)
                    && request.resource.data.homeId == resource.data.homeId
                    && homeReqUpdate(resource.data, request.resource.data, request.resource.data.diff(resource.data).affectedKeys());
      allow delete: if false;

      // Its history: append-only. Every entry is written by the signed-in user at the
      // server's time, and a fact is accepted only when the request itself says so.
      function homeReqPath() {
        return /databases/$(database)/documents/ledger_home_requests/$(rid);
      }
      // A checklist: one document per item, so two people ticking or adding at once never
      // overwrite each other. It is part of its request: read by whoever can read the
      // request, changed by the people the request is between (who asked, who wrote it,
      // whose it is now), frozen once the request is deleted. Who added and who ticked
      // an item are the signed-in user, never a client's claim.
      match /items/{itemId} {
        allow read: if canSee(get(homeReqPath()).data);
        allow create: if itemId.matches('^[A-Za-z0-9]{1,40}$')
                      && existsAfter(homeReqPath())
                      && listEditor(getAfter(homeReqPath()).data) && notDeleted(getAfter(homeReqPath()).data)
                      && itemShape(request.resource.data)
                      && request.resource.data.createdByUid == request.auth.uid
                      && request.resource.data.updatedByUid == request.auth.uid
                      && ((request.resource.data.done == false && request.resource.data.get('doneByUid', null) == null)
                          || (request.resource.data.done == true && request.resource.data.doneByUid == request.auth.uid));
        allow update: if listEditor(get(homeReqPath()).data) && notDeleted(get(homeReqPath()).data)
                      && itemShape(request.resource.data)
                      && request.resource.data.createdByUid == resource.data.createdByUid
                      && request.resource.data.createdAt == resource.data.createdAt
                      && request.resource.data.updatedByUid == request.auth.uid
                      && (request.resource.data.done == resource.data.done
                          ? (request.resource.data.get('doneByUid', null) == resource.data.get('doneByUid', null)
                             && request.resource.data.get('doneAt', null) == resource.data.get('doneAt', null))
                          : (request.resource.data.done == true
                             ? (request.resource.data.doneByUid == request.auth.uid && request.resource.data.doneAt is string)
                             : (request.resource.data.get('doneByUid', null) == null && request.resource.data.get('doneAt', null) == null)));
        allow delete: if listEditor(get(homeReqPath()).data) && notDeleted(get(homeReqPath()).data);
      }
      match /updates/{updateId} {
        allow read: if canSee(get(homeReqPath()).data);
        allow create: if request.resource.data.keys().hasOnly(['type', 'actorUid', 'text', 'createdAt', 'metadata'])
                      && request.resource.data.actorUid == request.auth.uid
                      && request.resource.data.createdAt == request.time
                      && (!('text' in request.resource.data) || request.resource.data.text == null
                          || (request.resource.data.text is string && request.resource.data.text.size() <= 500))
                      && (!('metadata' in request.resource.data) || request.resource.data.metadata is map)
                      && existsAfter(homeReqPath())
                      && canSee(getAfter(homeReqPath()).data)
                      && homeEntry(request.resource.data, getAfter(homeReqPath()).data, updateId, rid);
        allow update, delete: if false;
      }
    }
    // ---- Recurring responsibilities at Home (docs/HOME_RECURRENCE.md) ----
    // A template, set up once; the server makes one ordinary request from it on each due
    // date. Read like a request (admins, the people in it, or everyone when shared);
    // written by its creator or an admin; never deleted (End is a status). What the
    // server keeps (lastDate, lastRunAt, blocked) is never the client's to write.
    function recurDate(s) {
      return s is string && s.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }
    function recurSchedule(sc) {
      return sc is map
          && sc.keys().hasOnly(['freq', 'days', 'monthDay', 'every', 'startDate', 'endDate', 'time'])
          && sc.freq in ['daily', 'weekdays', 'weekly', 'monthly', 'interval']
          && recurDate(sc.startDate)
          && (sc.get('endDate', null) == null || (recurDate(sc.endDate) && sc.endDate >= sc.startDate))
          && (sc.get('time', null) == null || (sc.time is string && sc.time.matches('^[0-2][0-9]:[0-5][0-9]$')))
          && sc.get('days', []) is list && sc.get('days', []).size() <= 7 && sc.get('days', []).hasOnly([0, 1, 2, 3, 4, 5, 6])
          && (sc.freq != 'weekdays' || sc.days.size() > 0)
          && (sc.freq != 'weekly' || sc.days.size() == 1)
          && (sc.get('monthDay', 1) is int && sc.get('monthDay', 1) >= 1 && sc.get('monthDay', 1) <= 31)
          && (sc.get('every', 2) is int && sc.get('every', 2) >= 2 && sc.get('every', 2) <= 365);
    }
    function recurShape(d) {
      return d.keys().hasOnly(['homeId', 'title', 'note', 'why', 'createdByUid', 'mode', 'assigneeUid', 'visibility', 'schedule', 'timezone',
                               'checklist', 'status', 'createdAt', 'updatedAt', 'updatedByUid', 'endedAt', 'lastDate', 'lastRunAt', 'blocked'])
          && d.title is string && d.title.size() > 0 && d.title.size() <= 280
          && (d.get('note', null) == null || (d.note is string && d.note.size() <= 500))
          && homeWhy(d)
          && d.mode in ['assigned', 'anyone']
          && (d.mode == 'anyone'
              ? (d.get('assigneeUid', null) == null && d.visibility == 'home')
              : (d.assigneeUid is string && d.visibility in ['private', 'home']))
          && recurSchedule(d.schedule)
          && d.timezone is string && d.timezone.size() <= 64
          && d.get('checklist', []) is list && d.get('checklist', []).size() <= 40
          && d.status in ['active', 'paused', 'ended']
          && d.updatedByUid == request.auth.uid;
    }
    function recurServerKeys() {
      return ['lastDate', 'lastRunAt', 'blocked'];
    }
    match /ledger_home_recurring/{tid} {
      allow read: if inHome(resource.data.homeId)
                  && (me().role == 'admin' || request.auth.uid == resource.data.createdByUid
                      || request.auth.uid == resource.data.get('assigneeUid', null) || resource.data.visibility == 'home');
      allow create: if tid.matches('^[A-Za-z0-9]{1,40}$')
                    && inHome(request.resource.data.homeId)
                    && request.resource.data.createdByUid == request.auth.uid
                    && recurShape(request.resource.data)
                    && request.resource.data.status == 'active'
                    && (request.resource.data.mode == 'anyone' || activeIn(request.resource.data.assigneeUid, request.resource.data.homeId))
                    && !request.resource.data.keys().hasAny(recurServerKeys().concat(['endedAt']));
      allow update: if inHome(resource.data.homeId)
                    && (request.auth.uid == resource.data.createdByUid || me().role == 'admin')
                    && resource.data.status != 'ended'
                    && request.resource.data.homeId == resource.data.homeId
                    && request.resource.data.createdByUid == resource.data.createdByUid
                    && request.resource.data.createdAt == resource.data.createdAt
                    && !request.resource.data.diff(resource.data).affectedKeys().hasAny(recurServerKeys())
                    && recurShape(request.resource.data)
                    // a new person must be at Home; an existing one may have left (then End or reassign)
                    && (request.resource.data.mode == 'anyone'
                        || request.resource.data.assigneeUid == resource.data.get('assigneeUid', null)
                        || activeIn(request.resource.data.assigneeUid, resource.data.homeId));
      allow delete: if false;
    }

    // ---- Ongoing tasks at Home (docs/HOME_ONGOING.md) ----
    // A small parent record; its steps are ordinary requests carrying its id. Started and
    // kept by admins; read by admins, the people with a step in it, or everyone when
    // shared. Never deleted: finished (done) or archived.
    function ongoingPath(oid) {
      return /databases/$(database)/documents/ledger_home_ongoing/$(oid);
    }
    function ongoingOpenAfter(oid, homeId) {
      return oid is string && oid.matches('^[A-Za-z0-9]{1,40}$') && existsAfter(ongoingPath(oid))
          && getAfter(ongoingPath(oid)).data.homeId == homeId && getAfter(ongoingPath(oid)).data.status == 'active';
    }
    function ongoingShape(d) {
      return d.keys().hasOnly(['homeId', 'title', 'note', 'why', 'createdByUid', 'visibility', 'participants', 'status',
                               'stepOrder', 'fromRequestId', 'createdAt', 'updatedAt', 'updatedByUid', 'doneAt',
                               'waiting', 'latestUpdateAt', 'latestUpdateByUid', 'latestUpdateType', 'latestUpdateText'])
          && ongoingWaiting(d.get('waiting', null))
          && (d.get('latestUpdateText', null) == null || (d.latestUpdateText is string && d.latestUpdateText.size() <= 140))
          && d.title is string && d.title.size() > 0 && d.title.size() <= 280
          && (d.get('note', null) == null || (d.note is string && d.note.size() <= 500))
          && homeWhy(d)
          && d.visibility in ['private', 'home']
          && d.participants is list && d.participants.size() <= 20
          && d.status in ['active', 'done', 'archived']
          && d.get('stepOrder', []) is list && d.get('stepOrder', []).size() <= 100
          && (d.get('fromRequestId', null) == null || d.fromRequestId is string)
          && d.updatedByUid == request.auth.uid;
    }
    // waiting on someone outside the task: who (in words), since when, and when to chase
    function ongoingWaiting(w) {
      return w == null
          || (w is map && w.keys().hasOnly(['on', 'since', 'chaseBy', 'byUid'])
              && w.on is string && w.on.size() > 0 && w.on.size() <= 80
              && w.since is string && w.since.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
              && (w.get('chaseBy', null) == null || (w.chaseBy is string && w.chaseBy.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')))
              && w.byUid is string);
    }
    function ongoingSeen(d) {
      return inHome(d.homeId) && (me().role == 'admin' || request.auth.uid in d.participants || d.visibility == 'home');
    }
    match /ledger_home_ongoing/{oid} {
      allow read: if ongoingSeen(resource.data);
      allow create: if oid.matches('^[A-Za-z0-9]{1,40}$')
                    && homeAdmin(request.resource.data.homeId)
                    && request.resource.data.createdByUid == request.auth.uid
                    && request.resource.data.participants.hasAll([request.auth.uid])
                    && request.resource.data.status == 'active'
                    && request.resource.data.get('waiting', null) == null
                    && ongoingShape(request.resource.data);
      allow update: if (homeAdmin(resource.data.homeId)
                        && request.resource.data.homeId == resource.data.homeId
                        && request.resource.data.createdByUid == resource.data.createdByUid
                        && request.resource.data.createdAt == resource.data.createdAt
                        && request.resource.data.get('fromRequestId', null) == resource.data.get('fromRequestId', null)
                        && request.resource.data.participants.hasAll(resource.data.participants)
                        // waiting: left as it is, cleared, or set by this admin as themselves
                        && (request.resource.data.get('waiting', null) == resource.data.get('waiting', null)
                            || request.resource.data.get('waiting', null) == null
                            || request.resource.data.waiting.byUid == request.auth.uid)
                        && ongoingShape(request.resource.data))
                    // anyone with a step: the summary of the update they just wrote, nothing else
                    || (inHome(resource.data.homeId) && request.auth.uid in resource.data.participants
                        && request.resource.data.diff(resource.data).affectedKeys()
                             .hasOnly(['latestUpdateAt', 'latestUpdateByUid', 'latestUpdateType', 'latestUpdateText', 'updatedAt', 'updatedByUid'])
                        && request.resource.data.latestUpdateByUid == request.auth.uid
                        && request.resource.data.updatedByUid == request.auth.uid
                        && request.resource.data.latestUpdateType == 'comment'
                        && request.resource.data.latestUpdateText is string && request.resource.data.latestUpdateText.size() <= 140);
      allow delete: if false;
      // its updates: what anyone on it says, and (admins) waiting on someone and done waiting.
      // Read by whoever can see the task; never changed or removed.
      match /updates/{updateId} {
        allow read: if ongoingSeen(get(ongoingPath(oid)).data);
        allow create: if request.resource.data.keys().hasOnly(['type', 'actorUid', 'text', 'createdAt', 'metadata'])
                      && request.resource.data.actorUid == request.auth.uid
                      && request.resource.data.createdAt == request.time
                      && (request.resource.data.get('text', null) == null
                          || (request.resource.data.text is string && request.resource.data.text.size() <= 500))
                      && request.resource.data.get('metadata', {}) is map
                      && existsAfter(ongoingPath(oid))
                      && ((request.resource.data.type == 'comment' && request.resource.data.text is string && request.resource.data.text.size() > 0
                           && (homeAdmin(getAfter(ongoingPath(oid)).data.homeId)
                               || (inHome(getAfter(ongoingPath(oid)).data.homeId) && request.auth.uid in getAfter(ongoingPath(oid)).data.participants)))
                          || (request.resource.data.type in ['waiting', 'waiting_cleared'] && homeAdmin(getAfter(ongoingPath(oid)).data.homeId)));
        allow update, delete: if false;
      }
    }

    // "Tell me when it's ticked": one person's own wish to hear when a request is done
    // (itemId null) or one of its checklist items is ticked. Private: each person reads and
    // removes only their own, so Abi's choices never notify Shaun or show to anyone. Made
    // only for a request they can see; id {uid}_{requestId}_{itemId or "all"}. The server
    // checks they can still see it before telling them anything.
    match /ledger_home_watches/{wid} {
      allow read, delete: if signedIn() && resource.data.uid == request.auth.uid;
      allow create: if signedIn()
                    && request.resource.data.keys().hasOnly(['uid', 'homeId', 'requestId', 'itemId', 'createdAt'])
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.requestId is string && request.resource.data.requestId.matches('^[A-Za-z0-9_]{1,60}$')
                    && (request.resource.data.get('itemId', null) == null
                        || (request.resource.data.itemId is string && request.resource.data.itemId.matches('^[A-Za-z0-9]{1,40}$')))
                    && wid == request.auth.uid + '_' + request.resource.data.requestId + '_'
                              + (request.resource.data.get('itemId', null) == null ? 'all' : request.resource.data.itemId)
                    && request.resource.data.createdAt is string
                    && exists(/databases/$(database)/documents/ledger_home_requests/$(request.resource.data.requestId))
                    && get(/databases/$(database)/documents/ledger_home_requests/$(request.resource.data.requestId)).data.homeId == request.resource.data.homeId
                    && canSee(get(/databases/$(database)/documents/ledger_home_requests/$(request.resource.data.requestId)).data);
      allow update: if false;
    }

    // A list sent in one go: a note to the server that these requests went out together, so
    // each person hears ONE notification for all they were sent. Written once by whoever
    // sent them; nobody reads it back. The server checks every id against the requests
    // themselves (created by this person, in this list) before telling anyone anything.
    match /ledger_home_batches/{batchId} {
      allow read, update, delete: if false;
      allow create: if batchId.matches('^[A-Za-z0-9_]{1,48}$')
                    && inHome(request.resource.data.homeId)
                    && request.resource.data.keys().hasOnly(['homeId', 'createdByUid', 'batchId', 'requestIds', 'count', 'createdAt'])
                    && request.resource.data.createdByUid == request.auth.uid
                    && request.resource.data.batchId is string && batchId.matches('^' + request.resource.data.batchId + '(_[0-9]{1,3})?$')
                    && request.resource.data.requestIds is list
                    && request.resource.data.requestIds.size() > 0 && request.resource.data.requestIds.size() <= 40
                    && request.resource.data.count == request.resource.data.requestIds.size()
                    && request.resource.data.createdAt is string;
    }
    // who may edit a checklist: the people in the request, and (2026-10-28) any admin, as
    // admins already correct any open request
    function listEditor(p) {
      return inHome(p.homeId)
          && (request.auth.uid == p.requesterUid || request.auth.uid == p.createdByUid || request.auth.uid == p.assigneeUid
              || me().role == 'admin');
    }
    function itemShape(d) {
      return d.keys().hasOnly(['text', 'done', 'order', 'createdByUid', 'createdAt', 'doneByUid', 'doneAt', 'updatedByUid', 'updatedAt'])
          && d.text is string && d.text.size() > 0 && d.text.size() <= 200
          && d.done is bool && d.order is number
          && d.createdAt is string && d.updatedAt is string;
    }
    function homeEntry(d, p, updateId, rid) {
      return (notDeleted(p) && (
                (d.type == 'comment' && d.text is string && d.text.size() > 0)
                || (d.type == 'created' && updateId == 'created' && p.createdByUid == request.auth.uid && p.status == 'requested')
                || (d.type == 'withdrawn' && updateId == 'withdrawn' && p.status == 'withdrawn'
                    && (request.auth.uid == p.requesterUid || request.auth.uid == p.createdByUid))
                || (d.type == 'status' && d.metadata.status == p.status && p.status in ['done', 'requested']
                    && homeAdmin(p.homeId))
                || (request.auth.uid == p.assigneeUid
                    && ((d.type == 'planned' && p.status == 'planned')
                        || (d.type == 'moved' && d.metadata.toDate == p.get('plannedDate', null))
                        || (d.type == 'status' && d.metadata.status == p.status)
                        || (d.type == 'cant_do' && p.status == 'cant_do')))
                // only in the same write that passed it on: before, it was fromUid's
                || (d.type == 'reassigned' && d.metadata.toUid == p.assigneeUid && d.metadata.fromUid != p.assigneeUid
                    && get(/databases/$(database)/documents/ledger_home_requests/$(rid)).data.assigneeUid == d.metadata.fromUid
                    && (request.auth.uid == d.metadata.fromUid || homeAdmin(p.homeId)))
                || (d.type == 'claimed' && updateId == 'claimed' && p.assigneeUid == request.auth.uid
                    && get(/databases/$(database)/documents/ledger_home_requests/$(rid)).data.get('assigneeUid', null) == null)
                || (d.type == 'edited' && (homeAdmin(p.homeId) || request.auth.uid == p.requesterUid || request.auth.uid == p.createdByUid))
                || (d.type == 'visibility' && d.metadata.visibility == p.visibility
                    && (request.auth.uid == p.createdByUid || homeAdmin(p.homeId)))))
          || (d.type == 'deleted' && updateId == 'deleted' && p.get('deletedAt', null) != null
              && p.get('deletedByUid', null) == request.auth.uid);
    }

    // ---- Shared namespace: Partner Sharing ----
    // A partner never reads a private collection. What crosses the boundary is only
    // what the owner explicitly publishes here, to one named partner (by uid, never
    // by name), while the sharing relationship is active.
    function isPartner() {
      return hasRole('partner');
    }
    function memberDoc(ownerUid, partnerUid) {
      return /databases/$(database)/documents/ledger_share_members/$(ownerUid + '_' + partnerUid);
    }
    function activeMember(ownerUid, partnerUid) {
      return exists(memberDoc(ownerUid, partnerUid)) && get(memberDoc(ownerUid, partnerUid)).data.active == true;
    }
    function ownsIt(data) {
      return isOwner() && data.ownerUid == request.auth.uid;
    }

    // The relationship. Id: {ownerUid}_{partnerUid}. The owner creates and runs it, and
    // only for an account that already holds the partner role (granted outside the
    // client). The partner may read their own, to know whether sharing is on.
    match /ledger_share_members/{memberId} {
      allow read: if (isOwner() && resource.data.ownerUid == request.auth.uid)
                  || (isPartner() && resource.data.partnerUid == request.auth.uid);
      allow create: if isOwner()
                    && request.resource.data.ownerUid == request.auth.uid
                    && memberId == request.auth.uid + '_' + request.resource.data.partnerUid
                    && request.resource.data.role == 'partner'
                    && request.resource.data.active is bool
                    && exists(/databases/$(database)/documents/ledger_users/$(request.resource.data.partnerUid))
                    && get(/databases/$(database)/documents/ledger_users/$(request.resource.data.partnerUid)).data.role == 'partner';
      allow update: if isOwner()
                    && resource.data.ownerUid == request.auth.uid
                    && request.resource.data.ownerUid == resource.data.ownerUid
                    && request.resource.data.partnerUid == resource.data.partnerUid
                    && request.resource.data.role == 'partner'
                    && request.resource.data.active is bool;
      allow delete: if isOwner() && resource.data.ownerUid == request.auth.uid;
    }

    // A published projection: share-safe display data only, never a private record.
    // Id: {ownerUid}_{partnerUid}_{periodType}_{periodKey}. Readable by its partner
    // only while the relationship is active.
    match /ledger_shared_snapshots/{snapId} {
      allow read: if (isOwner() && resource.data.ownerUid == request.auth.uid)
                  || (isPartner()
                      && resource.data.partnerUid == request.auth.uid
                      && activeMember(resource.data.ownerUid, request.auth.uid));
      allow create, update: if isOwner()
                    && request.resource.data.ownerUid == request.auth.uid
                    && (resource == null || resource.data.ownerUid == request.auth.uid)
                    && request.resource.data.periodType in ['day', 'week']
                    && snapId == request.auth.uid + '_' + request.resource.data.partnerUid + '_'
                                 + request.resource.data.periodType + '_' + request.resource.data.periodKey
                    && exists(memberDoc(request.auth.uid, request.resource.data.partnerUid));
      allow delete: if isOwner() && resource.data.ownerUid == request.auth.uid;
    }

    // Requests from a partner: capture for the owner to decide on, never an Action.
    // The partner creates them (through their own active relationship), may edit or
    // withdraw one until the owner has acted on it, and reads their own. Only the owner
    // moves a request on — planned, in progress, done, dismissed — and links it to an
    // Action. Either side keeps the request's small summary of its latest update and
    // their own "last read" mark, never the other side's.
    //
    // Three separate facts, never conflated: the requester is always the partner
    // (partnerUid), the assignee always the owner (ownerUid), and the creator is whoever
    // actually wrote it (createdByUid, always the signed-in user; absent on requests from
    // before it was recorded, which the partner wrote). The owner may record a request
    // the partner made in person — "on their behalf" — only for the partner of their own
    // active relationship. Provenance is written once and never changes: no update rule
    // below lets either side touch createdByUid, createdByRole or the deletion fields.
    //
    // Deleting is soft: deletedAt / deletedByUid / deletedByRole, written once by the
    // partner who asked (any of their requests) or by the owner who created it on their
    // behalf. A deleted request is never changed again by anyone — not edited, processed,
    // renewed, read-marked or given new Updates — so a stale device cannot bring it back.
    function requestText(d) {
      return d.text is string && d.text.size() > 0 && d.text.size() <= 280
          && (!('note' in d) || d.note == null || (d.note is string && d.note.size() <= 500))
          && d.requestedTiming in ['today', 'week', 'date', 'none', 'later']
          && (!('requestedDate' in d) || d.requestedDate == null || d.requestedDate is string);
    }
    // the summary of the latest update may only name the side writing it
    function summaryBy(role) {
      let d = request.resource.data;
      let o = resource == null ? {} : resource.data;
      return (d.get('latestUpdateBy', null) == o.get('latestUpdateBy', null)
              || (role == 'owner' && d.latestUpdateBy in ['owner', 'system'])
              || (role == 'partner' && d.latestUpdateBy == 'partner'))
          && (d.get('latestCommentBy', null) == o.get('latestCommentBy', null) || d.latestCommentBy == role)
          && (d.get('latestCommentText', null) == null
              || (d.latestCommentText is string && d.latestCommentText.size() <= 500));
    }
    function partnerCanReach(data) {
      return isPartner()
          && data.partnerUid == request.auth.uid
          && activeMember(data.ownerUid, request.auth.uid);
    }
    function notDeleted(data) {
      return data.get('deletedAt', null) == null;
    }
    // the one write that deletes: the three deletion fields (and the time), by the
    // signed-in user, said as their own role
    function deletes(role) {
      return request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['deletedAt', 'deletedByUid', 'deletedByRole', 'updatedAt'])
          && request.resource.data.deletedAt is string
          && request.resource.data.deletedByUid == request.auth.uid
          && request.resource.data.deletedByRole == role;
    }
    // "Move to upcoming": a withdrawn request is never revived. A new request is made
    // from it, and the two point at each other — the new one's renewedFrom, the old
    // one's renewedAs — so each withdrawn request is renewed once, by its own partner.
    function renewsWithdrawn(newId, oldId) {
      return oldId is string && oldId.matches('^[A-Za-z0-9]{1,40}$')
          && exists(requestPath(oldId))
          && get(requestPath(oldId)).data.status == 'withdrawn'
          && get(requestPath(oldId)).data.partnerUid == request.auth.uid
          && get(requestPath(oldId)).data.ownerUid == request.resource.data.ownerUid
          && get(requestPath(oldId)).data.get('renewedAs', null) == null
          && notDeleted(get(requestPath(oldId)).data)
          && getAfter(requestPath(oldId)).data.get('renewedAs', null) == newId;
    }
    match /ledger_shared_requests/{requestId} {
      allow read: if (isOwner() && resource.data.ownerUid == request.auth.uid)
                  || partnerCanReach(resource.data);
      // the id is the partner's to choose, so it is held to the shape of an ordinary
      // generated id — it is never more than an id wherever it is shown
      allow create: if (isPartner()
                    && requestId.matches('^[A-Za-z0-9]{1,40}$')
                    && request.resource.data.partnerUid == request.auth.uid
                    && activeMember(request.resource.data.ownerUid, request.auth.uid)
                    && request.resource.data.keys().hasOnly(['ownerUid', 'partnerUid', 'text', 'note', 'requestedTiming',
                         'requestedDate', 'createdAt', 'updatedAt', 'status', 'plannedDate', 'linkedActionId',
                         'latestUpdateAt', 'latestUpdateBy', 'latestUpdateType', 'partnerLastReadAt', 'renewedFrom',
                         'createdByUid', 'createdByRole'])
                    && request.resource.data.get('createdByUid', request.auth.uid) == request.auth.uid
                    && request.resource.data.get('createdByRole', 'partner') == 'partner'
                    && request.resource.data.status == 'requested'
                    && (request.resource.data.get('renewedFrom', null) == null
                        || renewsWithdrawn(requestId, request.resource.data.renewedFrom))
                    && (!('plannedDate' in request.resource.data) || request.resource.data.plannedDate == null)
                    && (!('linkedActionId' in request.resource.data) || request.resource.data.linkedActionId == null)
                    && request.resource.data.get('latestUpdateBy', 'partner') == 'partner'
                    && requestText(request.resource.data))
                    // the owner, recording what the partner asked in person: for the partner
                    // of their own active relationship, as a new request like any other,
                    // with themselves named as its creator
                    || (isOwner()
                    && requestId.matches('^[A-Za-z0-9]{1,40}$')
                    && request.resource.data.ownerUid == request.auth.uid
                    && request.resource.data.partnerUid is string
                    && request.resource.data.partnerUid != request.auth.uid
                    && activeMember(request.auth.uid, request.resource.data.partnerUid)
                    && request.resource.data.keys().hasOnly(['ownerUid', 'partnerUid', 'text', 'note', 'requestedTiming',
                         'requestedDate', 'createdAt', 'updatedAt', 'status', 'plannedDate', 'linkedActionId',
                         'latestUpdateAt', 'latestUpdateBy', 'latestUpdateType', 'ownerLastReadAt',
                         'createdByUid', 'createdByRole'])
                    && request.resource.data.createdByUid == request.auth.uid
                    && request.resource.data.createdByRole == 'owner'
                    && request.resource.data.status == 'requested'
                    && (!('plannedDate' in request.resource.data) || request.resource.data.plannedDate == null)
                    && (!('linkedActionId' in request.resource.data) || request.resource.data.linkedActionId == null)
                    && request.resource.data.get('latestUpdateBy', 'owner') == 'owner'
                    && requestText(request.resource.data));
      allow update: if notDeleted(resource.data) && ((partnerCanReach(resource.data)
                        && (
                          // wording and timing, only while it is still a request
                          (resource.data.status == 'requested'
                           && request.resource.data.diff(resource.data).affectedKeys()
                                .hasOnly(['text', 'note', 'requestedTiming', 'requestedDate', 'updatedAt'])
                           && requestText(request.resource.data))
                          // withdrawing it, only while it is still a request
                          || (resource.data.status == 'requested'
                              && request.resource.data.status == 'withdrawn'
                              && request.resource.data.diff(resource.data).affectedKeys()
                                   .hasOnly(['status', 'updatedAt', 'latestUpdateAt', 'latestUpdateBy', 'latestUpdateType'])
                              && summaryBy('partner'))
                          // a withdrawn request, once: renewed as a new request (the new one
                          // must name this one in the same write)
                          || (resource.data.status == 'withdrawn'
                              && request.resource.data.status == 'withdrawn'
                              && resource.data.get('renewedAs', null) == null
                              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['renewedAs', 'updatedAt'])
                              && request.resource.data.renewedAs is string
                              && existsAfter(requestPath(request.resource.data.renewedAs))
                              && getAfter(requestPath(request.resource.data.renewedAs)).data.get('renewedFrom', null) == requestId
                              && getAfter(requestPath(request.resource.data.renewedAs)).data.partnerUid == request.auth.uid)
                          // a withdrawn request, hidden from (or back in) their own list. It is
                          // never deleted: the owner's copy and its history are untouched.
                          || (resource.data.status == 'withdrawn'
                              && request.resource.data.status == 'withdrawn'
                              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['partnerHiddenAt', 'updatedAt'])
                              && (request.resource.data.partnerHiddenAt == null || request.resource.data.partnerHiddenAt is string))
                          // their update's summary, and their own read mark, at any time
                          || (request.resource.data.diff(resource.data).affectedKeys()
                                .hasOnly(['latestUpdateAt', 'latestUpdateBy', 'latestUpdateType', 'latestCommentAt',
                                          'latestCommentBy', 'latestCommentText', 'partnerLastReadAt', 'updatedAt'])
                              && summaryBy('partner'))))
                    // the owner: where it went, never what was asked or by whom
                    || (ownsIt(resource.data)
                        && request.resource.data.diff(resource.data).affectedKeys()
                             .hasOnly(['status', 'plannedDate', 'linkedActionId', 'updatedAt', 'processedAt',
                                       'latestUpdateAt', 'latestUpdateBy', 'latestUpdateType', 'latestCommentAt',
                                       'latestCommentBy', 'latestCommentText', 'ownerLastReadAt'])
                        && request.resource.data.status in ['requested', 'planned', 'in_progress', 'done', 'dismissed']
                        && (resource.data.status != 'withdrawn' || request.resource.data.status == 'withdrawn')
                        && summaryBy('owner'))
                    // deleting (soft): the partner, any request of theirs; the owner, only one
                    // they created on the partner's behalf
                    || (partnerCanReach(resource.data) && deletes('partner'))
                    || (ownsIt(resource.data)
                        && resource.data.get('createdByUid', null) == request.auth.uid
                        && resource.data.get('createdByRole', null) == 'owner'
                        && deletes('owner')));
      // never removed from Firestore by a client: withdrawn, dismissed and deleted are
      // states, so a linked Action and the history keep something to point at. A partner
      // hides a withdrawn one from their own list (partnerHiddenAt).
      allow delete: if false;
    }

    // A request's Updates: a short shared history — what either side said, and what
    // happened. Entries are never edited or removed. Every entry must belong to an
    // existing request of the same relationship, written by the signed-in user, at the
    // server's time. The partner writes what they said (a comment) and the two facts that
    // are theirs alone — they asked, they withdrew — each once; everything that happened
    // to the Action (planned, moved, status, dismissed) comes only from the owner, and only
    // when the request itself says so.
    function requestPath(id) {
      return /databases/$(database)/documents/ledger_shared_requests/$(id);
    }
    function updateShape(d) {
      return d.keys().hasOnly(['requestId', 'ownerUid', 'partnerUid', 'type', 'actorUid', 'actorRole', 'text', 'createdAt', 'metadata'])
          && d.requestId is string
          && d.actorUid == request.auth.uid
          && d.createdAt == request.time
          && (!('text' in d) || d.text == null || (d.text is string && d.text.size() <= 500))
          && (!('metadata' in d) || d.metadata is map);
    }
    function isComment(d) {
      return d.type == 'comment' && d.text is string && d.text.size() > 0;
    }
    function ownerUpdate(d, p, updateId) {
      return isOwner()
          && d.ownerUid == request.auth.uid
          && ((d.actorRole == 'owner' && isComment(d))
              // "created by the owner on the partner's behalf": once, with the request it names
              || (d.actorRole == 'owner' && d.type == 'request_created' && updateId == d.requestId + '_created'
                  && p.status == 'requested' && p.get('createdByUid', null) == request.auth.uid
                  && p.get('createdByRole', null) == 'owner')
              || (d.actorRole == 'system'
                  && ((d.type == 'planned' && p.status == 'planned' && p.linkedActionId != null)
                      || (d.type == 'moved' && p.plannedDate == d.metadata.toDate)
                      || (d.type == 'status' && p.status == d.metadata.status)
                      || (d.type == 'dismissed' && p.status == 'dismissed'))));
    }
    function partnerUpdate(d, p, updateId) {
      return isPartner()
          && d.partnerUid == request.auth.uid
          && d.actorRole == 'partner'
          && activeMember(d.ownerUid, request.auth.uid)
          && (isComment(d)
              || (d.type == 'request_created' && updateId == d.requestId + '_created' && p.status == 'requested')
              || (d.type == 'withdrawn' && updateId == d.requestId + '_withdrawn' && p.status == 'withdrawn')
              || (d.type == 'renewed' && updateId == d.requestId + '_renewed' && p.status == 'withdrawn'
                  && p.get('renewedAs', null) != null));
    }
    // "deleted": the one entry a deleted request may still gain — once, by whoever
    // deleted it, as their own role
    function deletedUpdate(d, p, updateId) {
      return d.type == 'deleted'
          && updateId == d.requestId + '_deleted'
          && p.get('deletedAt', null) != null
          && p.get('deletedByUid', null) == request.auth.uid
          && ((isOwner() && d.ownerUid == request.auth.uid && d.actorRole == 'owner' && p.deletedByRole == 'owner')
              || (isPartner() && d.partnerUid == request.auth.uid && d.actorRole == 'partner' && p.deletedByRole == 'partner'
                  && activeMember(d.ownerUid, request.auth.uid)));
    }
    match /ledger_shared_request_updates/{updateId} {
      allow read: if (isOwner() && resource.data.ownerUid == request.auth.uid)
                  || partnerCanReach(resource.data);
      allow create: if signedIn()
                    && updateShape(request.resource.data)
                    && existsAfter(requestPath(request.resource.data.requestId))
                    && getAfter(requestPath(request.resource.data.requestId)).data.ownerUid == request.resource.data.ownerUid
                    && getAfter(requestPath(request.resource.data.requestId)).data.partnerUid == request.resource.data.partnerUid
                    && ((notDeleted(getAfter(requestPath(request.resource.data.requestId)).data)
                         && (ownerUpdate(request.resource.data, getAfter(requestPath(request.resource.data.requestId)).data, updateId)
                             || partnerUpdate(request.resource.data, getAfter(requestPath(request.resource.data.requestId)).data, updateId)))
                        || deletedUpdate(request.resource.data, getAfter(requestPath(request.resource.data.requestId)).data, updateId));
      allow update, delete: if false;
    }
  }
}
