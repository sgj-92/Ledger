rules_version = '2';

// Ledger — Firestore security rules.
//
// The identity boundary is Firebase Authentication. Who may do what is data, not code:
// a profile at ledger_users/{uid} carries a role, "owner" or "partner". Profiles are
// created in the Firebase Console (or with the Admin SDK) — no client can write one, so
// no one can grant themselves a role by signing up.
//
// Ledger is a single-owner app: every existing ledger_* collection is the owner's
// private data and is readable and writable only by an authenticated user whose
// profile role is "owner". A partner gets nothing from these collections, ever.
// Partner access is only through separate, explicitly shared
// collections (see "Shared namespace" below) — never a filtered view of private ones.
//
// Anything not matched here is denied.
//
// Deploy: firebase deploy --only firestore:rules   (see docs/SECURITY.md first —
// the owner profile must exist before these rules go live).

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }
    function profilePath() {
      return /databases/$(database)/documents/ledger_users/$(request.auth.uid);
    }
    function hasRole(role) {
      return signedIn() && exists(profilePath()) && get(profilePath()).data.role == role;
    }
    function isOwner() {
      return hasRole('owner');
    }

    // ---- Identity ----
    // A signed-in user may read their own profile (so the app can learn its role);
    // the owner may read all of them. Roles are granted outside the client only.
    match /ledger_users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isOwner());
      allow write: if false;
    }

    // ---- Private Ledger data: owner only ----
    match /ledger_commitments/{docId=**}        { allow read, write: if isOwner(); }
    match /ledger_plans/{docId=**}              { allow read, write: if isOwner(); }
    match /ledger_sessions/{docId=**}           { allow read, write: if isOwner(); }   // training, weight, steps, nutrition, photos, symptoms
    match /ledger_day_status/{docId=**}         { allow read, write: if isOwner(); }
    match /ledger_priorities/{docId=**}         { allow read, write: if isOwner(); }
    match /ledger_focus/{docId=**}              { allow read, write: if isOwner(); }
    match /ledger_meals/{docId=**}              { allow read, write: if isOwner(); }
    match /ledger_meta/{docId=**}               { allow read, write: if isOwner(); }
    match /ledger_matters/{docId=**}            { allow read, write: if isOwner(); }
    match /ledger_conversations/{docId=**}      { allow read, write: if isOwner(); }
    match /ledger_challenges/{docId=**}         { allow read, write: if isOwner(); }

    // ---- Web Push (Pin now): owner only ----
    // Device subscriptions and the pins that trigger a push. The sending Cloud Function
    // uses the Admin SDK, which is not subject to these rules.
    match /ledger_push_subscriptions/{docId=**} { allow read, write: if isOwner(); }
    match /ledger_pins/{docId=**}               { allow read, write: if isOwner(); }

    // ---- Shared namespace: Partner Sharing ----
    // A partner never reads a private collection. What crosses the boundary is only
    // what the owner explicitly publishes here, to one named partner (by uid, never
    // by name), while the sharing relationship is active.
    function isPartner() {
      return hasRole('partner');
    }
    function memberDoc(ownerUid, partnerUid) {
      return /databases/$(database)/documents/ledger_share_members/$(ownerUid + '_' + partnerUid);
    }
    function activeMember(ownerUid, partnerUid) {
      return exists(memberDoc(ownerUid, partnerUid)) && get(memberDoc(ownerUid, partnerUid)).data.active == true;
    }
    function ownsIt(data) {
      return isOwner() && data.ownerUid == request.auth.uid;
    }

    // The relationship. Id: {ownerUid}_{partnerUid}. The owner creates and runs it, and
    // only for an account that already holds the partner role (granted outside the
    // client). The partner may read their own, to know whether sharing is on.
    match /ledger_share_members/{memberId} {
      allow read: if (isOwner() && resource.data.ownerUid == request.auth.uid)
                  || (isPartner() && resource.data.partnerUid == request.auth.uid);
      allow create: if isOwner()
                    && request.resource.data.ownerUid == request.auth.uid
                    && memberId == request.auth.uid + '_' + request.resource.data.partnerUid
                    && request.resource.data.role == 'partner'
                    && request.resource.data.active is bool
                    && exists(/databases/$(database)/documents/ledger_users/$(request.resource.data.partnerUid))
                    && get(/databases/$(database)/documents/ledger_users/$(request.resource.data.partnerUid)).data.role == 'partner';
      allow update: if isOwner()
                    && resource.data.ownerUid == request.auth.uid
                    && request.resource.data.ownerUid == resource.data.ownerUid
                    && request.resource.data.partnerUid == resource.data.partnerUid
                    && request.resource.data.role == 'partner'
                    && request.resource.data.active is bool;
      allow delete: if isOwner() && resource.data.ownerUid == request.auth.uid;
    }

    // A published projection: share-safe display data only, never a private record.
    // Id: {ownerUid}_{partnerUid}_{periodType}_{periodKey}. Readable by its partner
    // only while the relationship is active.
    match /ledger_shared_snapshots/{snapId} {
      allow read: if (isOwner() && resource.data.ownerUid == request.auth.uid)
                  || (isPartner()
                      && resource.data.partnerUid == request.auth.uid
                      && activeMember(resource.data.ownerUid, request.auth.uid));
      allow create, update: if isOwner()
                    && request.resource.data.ownerUid == request.auth.uid
                    && (resource == null || resource.data.ownerUid == request.auth.uid)
                    && request.resource.data.periodType in ['day', 'week']
                    && snapId == request.auth.uid + '_' + request.resource.data.partnerUid + '_'
                                 + request.resource.data.periodType + '_' + request.resource.data.periodKey
                    && exists(memberDoc(request.auth.uid, request.resource.data.partnerUid));
      allow delete: if isOwner() && resource.data.ownerUid == request.auth.uid;
    }

    // Requests from a partner: capture for the owner to decide on, never an Action.
    // The partner creates them (through their own active relationship), may edit or
    // withdraw one until the owner has acted on it, and reads their own. Only the owner
    // moves a request on — planned, done, dismissed — and links it to an Action.
    function requestText(d) {
      return d.text is string && d.text.size() > 0 && d.text.size() <= 280
          && (!('note' in d) || d.note == null || (d.note is string && d.note.size() <= 500))
          && d.requestedTiming in ['today', 'week', 'date', 'none']
          && (!('requestedDate' in d) || d.requestedDate == null || d.requestedDate is string);
    }
    match /ledger_shared_requests/{requestId} {
      allow read: if (isOwner() && resource.data.ownerUid == request.auth.uid)
                  || (isPartner()
                      && resource.data.partnerUid == request.auth.uid
                      && activeMember(resource.data.ownerUid, request.auth.uid));
      // the id is the partner's to choose, so it is held to the shape of an ordinary
      // generated id — it is never more than an id wherever it is shown
      allow create: if isPartner()
                    && requestId.matches('^[A-Za-z0-9]{1,40}$')
                    && request.resource.data.partnerUid == request.auth.uid
                    && activeMember(request.resource.data.ownerUid, request.auth.uid)
                    && request.resource.data.keys().hasOnly(['ownerUid', 'partnerUid', 'text', 'note', 'requestedTiming',
                         'requestedDate', 'createdAt', 'updatedAt', 'status', 'plannedDate', 'linkedActionId'])
                    && request.resource.data.status == 'requested'
                    && (!('plannedDate' in request.resource.data) || request.resource.data.plannedDate == null)
                    && (!('linkedActionId' in request.resource.data) || request.resource.data.linkedActionId == null)
                    && requestText(request.resource.data);
      // the partner: wording and timing only, and only while it is still a request
      allow update: if (isPartner()
                        && resource.data.partnerUid == request.auth.uid
                        && activeMember(resource.data.ownerUid, request.auth.uid)
                        && resource.data.status == 'requested'
                        && request.resource.data.diff(resource.data).affectedKeys()
                             .hasOnly(['text', 'note', 'requestedTiming', 'requestedDate', 'updatedAt'])
                        && requestText(request.resource.data))
                    // the owner: where it went, never what was asked or by whom
                    || (ownsIt(resource.data)
                        && request.resource.data.diff(resource.data).affectedKeys()
                             .hasOnly(['status', 'plannedDate', 'linkedActionId', 'updatedAt', 'processedAt'])
                        && request.resource.data.status in ['requested', 'planned', 'done', 'dismissed']);
      allow delete: if isPartner()
                    && resource.data.partnerUid == request.auth.uid
                    && resource.data.status == 'requested'
                    && (!('linkedActionId' in resource.data) || resource.data.linkedActionId == null);
    }
  }
}
